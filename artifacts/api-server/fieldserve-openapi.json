            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/complete": {
      "post": {
        "operationId": "completeJob",
        "summary": "Mark job as completed",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/fail": {
      "post": {
        "operationId": "failJob",
