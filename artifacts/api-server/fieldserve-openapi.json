{
  "openapi": "3.0.3",
  "info": {
    "title": "FieldServe API",
    "description": "Mitie-style job workflow engine for facilities management. Supports job lifecycle with 18 states, engineer assignment, site management, and dashboard analytics.",
    "version": "1.0.0"
  },
  "servers": [
    { "url": "/api/fieldserve", "description": "FieldServe API" }
  ],
  "security": [{ "bearerAuth": [] }],
  "paths": {
    "/jobs": {
      "get": {
        "operationId": "listJobs",
        "summary": "List jobs with filters",
        "tags": ["Jobs"],
        "parameters": [
          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/JobStatus" } },
          { "name": "engineer_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "site_id", "in": "query", "schema": { "type": "integer" } },
          { "name": "priority", "in": "query", "schema": { "$ref": "#/components/schemas/Priority" } },
          { "name": "page", "in": "query", "schema": { "type": "integer", "default": 0 } },
          { "name": "limit", "in": "query", "schema": { "type": "integer", "default": 50, "maximum": 200 } },
          { "name": "sort", "in": "query", "schema": { "type": "string", "enum": ["created_at", "priority", "scheduled_date"], "default": "created_at" } },
          { "name": "order", "in": "query", "schema": { "type": "string", "enum": ["asc", "desc"], "default": "desc" } }
        ],
        "responses": {
          "200": {
            "description": "Paginated job list",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "jobs": { "type": "array", "items": { "$ref": "#/components/schemas/Job" } },
                    "total": { "type": "integer" }
                  }
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createJob",
        "summary": "Create a new job",
        "tags": ["Jobs"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CreateJobInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Job created",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": { "$ref": "#/components/schemas/Job" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" }
        }
      }
    },
    "/jobs/{id}": {
      "get": {
        "operationId": "getJob",
        "summary": "Get job with site, engineer, updates, and attachments",
        "tags": ["Jobs"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "responses": {
          "200": {
            "description": "Job with relations",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": { "$ref": "#/components/schemas/JobWithRelations" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "patch": {
        "operationId": "updateJob",
        "summary": "Update job fields",
        "tags": ["Jobs"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/UpdateJobInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Job updated",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "job": { "$ref": "#/components/schemas/Job" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" }
        }
      },
      "delete": {
        "operationId": "deleteJob",
        "summary": "Delete a job (only status=created)",
        "tags": ["Jobs"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "responses": {
          "200": {
            "description": "Job deleted",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" }
                  }
                }
              }
            }
          },
          "404": { "$ref": "#/components/responses/NotFound" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/assign": {
      "post": {
        "operationId": "assignJob",
        "summary": "Assign an engineer to a job",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["engineerId"],
                "properties": {
                  "engineerId": { "type": "integer" },
                  "notes": { "type": "string" }
                }
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/dispatch": {
      "post": {
        "operationId": "dispatchJob",
        "summary": "Dispatch engineer to site",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/en-route": {
      "post": {
        "operationId": "enRouteJob",
        "summary": "Engineer is en route",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/on-site": {
      "post": {
        "operationId": "onSiteJob",
        "summary": "Engineer arrived on site",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/TransitionBody" },
                  {
                    "type": "object",
                    "properties": {
                      "lat": { "type": "number" },
                      "lng": { "type": "number" }
                    }
                  }
                ]
              }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/check-in": {
      "post": {
        "operationId": "checkInJob",
        "summary": "Engineer checked in at site",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/grant-access": {
      "post": {
        "operationId": "grantAccess",
        "summary": "Grant access to site (waiting for access)",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/equipment-received": {
      "post": {
        "operationId": "equipmentReceived",
        "summary": "Equipment received (waiting for equipment)",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
    },
    "/jobs/{id}/start-work": {
      "post": {
        "operationId": "startWork",
        "summary": "Start work on the job",
        "tags": ["Transitions"],
        "parameters": [
          { "$ref": "#/components/parameters/JobId" }
        ],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/TransitionBody" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/JobResponse" },
          "409": { "$ref": "#/components/responses/Conflict" }
        }
      }
