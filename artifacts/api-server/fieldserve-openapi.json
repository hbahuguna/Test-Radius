          { "name": "status", "in": "query", "schema": { "$ref": "#/components/schemas/EngineerStatus" } },
          { "name": "available", "in": "query", "schema": { "type": "string", "enum": ["true"] } }
        ],
        "responses": {
          "200": {
            "description": "Engineer list",
