    "/seed": {
      "post": {
        "operationId": "seedData",
        "summary": "Seed demo data (20 jobs, 10 engineers, 5 sites)",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Data seeded",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/reset": {
      "post": {
        "operationId": "resetData",
        "summary": "Clear all data",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Data cleared",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "ok": { "type": "boolean" },
                    "message": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "healthCheck",
        "summary": "Health check",
        "tags": ["System"],
        "responses": {
          "200": {
            "description": "Service healthy",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "status": { "type": "string" },
                    "service": { "type": "string" },
                    "timestamp": { "type": "string", "format": "date-time" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "parameters": {
      "JobId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "EngineerId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      },
      "SiteId": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "type": "integer" }
      }
    },
    "responses": {
      "BadRequest": {
        "description": "Invalid request",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Resource not found",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Conflict (invalid transition, duplicate, engineer unavailable)",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "JobResponse": {
        "description": "Job after transition",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "job": { "$ref": "#/components/schemas/Job" }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "JobStatus": {
        "type": "string",
        "enum": [
          "created", "scheduled", "assigned", "engineer-dispatched",
          "en-route", "on-site", "checking-in", "waiting-for-access",
          "waiting-for-equipment", "in-progress", "on-hold",
          "completed", "failed", "cancelled", "deferred",
          "facility-not-accessible", "parts-required", "requires-rescheduling"
        ]
      },
      "Priority": {
        "type": "string",
        "enum": ["critical", "high", "medium", "low"]
      },
      "EngineerSkill": {
        "type": "string",
        "enum": ["electrical", "plumbing", "hvac", "fire-safety", "general-maintenance"]
      },
      "EngineerStatus": {
        "type": "string",
        "enum": ["available", "busy", "on-leave"]
      },
      "Job": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "title": { "type": "string" },
          "description": { "type": "string", "nullable": true },
          "siteId": { "type": "integer" },
          "skillRequired": { "type": "string" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "status": { "$ref": "#/components/schemas/JobStatus" },
          "assignedEngineerId": { "type": "integer", "nullable": true },
          "scheduledDate": { "type": "string", "nullable": true },
          "estimatedDuration": { "type": "integer", "nullable": true },
          "slaDeadline": { "type": "string", "nullable": true },
          "createdAt": { "type": "string" },
          "updatedAt": { "type": "string" }
        }
      },
      "JobWithRelations": {
        "allOf": [
          { "$ref": "#/components/schemas/Job" },
          {
            "type": "object",
            "properties": {
              "site": { "$ref": "#/components/schemas/Site" },
              "engineer": { "$ref": "#/components/schemas/Engineer" },
              "updates": { "type": "array", "items": { "$ref": "#/components/schemas/JobUpdate" } },
              "attachments": { "type": "array", "items": { "$ref": "#/components/schemas/Attachment" } }
            }
          }
        ]
      },
      "CreateJobInput": {
        "type": "object",
        "required": ["title", "siteId", "skillRequired"],
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "siteId": { "type": "integer" },
          "skillRequired": { "type": "string" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "scheduledDate": { "type": "string" },
          "estimatedDuration": { "type": "integer" },
          "slaDeadline": { "type": "string" }
        }
      },
      "UpdateJobInput": {
        "type": "object",
        "properties": {
          "title": { "type": "string" },
          "description": { "type": "string" },
          "priority": { "$ref": "#/components/schemas/Priority" },
          "scheduledDate": { "type": "string" },
          "estimatedDuration": { "type": "integer" },
          "slaDeadline": { "type": "string" },
          "siteId": { "type": "integer" },
          "skillRequired": { "type": "string" }
        }
      },
      "TransitionBody": {
        "type": "object",
        "properties": {
          "notes": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "engineerId": { "type": "integer" }
        }
      },
      "Engineer": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string", "nullable": true },
          "employeeId": { "type": "string" },
          "skills": { "type": "array", "items": { "type": "string" } },
          "status": { "$ref": "#/components/schemas/EngineerStatus" },
          "currentLat": { "type": "number", "nullable": true },
          "currentLng": { "type": "number", "nullable": true },
          "createdAt": { "type": "string" }
        }
      },
      "EngineerWithRelations": {
        "allOf": [
          { "$ref": "#/components/schemas/Engineer" },
          {
            "type": "object",
            "properties": {
              "activeJob": { "$ref": "#/components/schemas/Job" }
            }
          }
        ]
      },
      "CreateEngineerInput": {
        "type": "object",
        "required": ["firstName", "lastName", "email", "employeeId"],
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "phone": { "type": "string" },
          "employeeId": { "type": "string" },
          "skills": { "type": "array", "items": { "$ref": "#/components/schemas/EngineerSkill" } }
        }
      },
      "UpdateEngineerInput": {
        "type": "object",
        "properties": {
          "firstName": { "type": "string" },
          "lastName": { "type": "string" },
          "email": { "type": "string" },
          "status": { "$ref": "#/components/schemas/EngineerStatus" },
          "skills": { "type": "array", "items": { "$ref": "#/components/schemas/EngineerSkill" } }
        }
      },
      "Site": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "name": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "postcode": { "type": "string" },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true },
          "accessInstructions": { "type": "string", "nullable": true },
          "contactName": { "type": "string", "nullable": true },
          "contactPhone": { "type": "string", "nullable": true },
          "createdAt": { "type": "string" }
        }
      },
      "CreateSiteInput": {
        "type": "object",
        "required": ["name", "address", "city", "postcode"],
        "properties": {
          "name": { "type": "string" },
          "address": { "type": "string" },
          "city": { "type": "string" },
          "postcode": { "type": "string" },
          "lat": { "type": "number" },
          "lng": { "type": "number" },
          "accessInstructions": { "type": "string" },
          "contactName": { "type": "string" },
          "contactPhone": { "type": "string" }
        }
      },
      "JobUpdate": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "jobId": { "type": "integer" },
          "engineerId": { "type": "integer", "nullable": true },
          "fromStatus": { "type": "string", "nullable": true },
          "toStatus": { "type": "string" },
          "notes": { "type": "string", "nullable": true },
          "lat": { "type": "number", "nullable": true },
          "lng": { "type": "number", "nullable": true },
          "createdAt": { "type": "string" }
        }
      },
      "Attachment": {
        "type": "object",
        "properties": {
          "id": { "type": "integer" },
          "jobId": { "type": "integer" },
          "engineerId": { "type": "integer", "nullable": true },
          "fileName": { "type": "string" },
          "fileType": { "type": "string" },
          "fileSize": { "type": "integer" },
          "createdAt": { "type": "string" }
        }
      },
      "DashboardStats": {
        "type": "object",
        "properties": {
          "totalJobs": { "type": "integer" },
          "byStatus": {
            "type": "object",
            "properties": {
              "created": { "type": "integer" },
              "scheduled": { "type": "integer" },
              "assigned": { "type": "integer" },
              "engineer-dispatched": { "type": "integer" },
              "en-route": { "type": "integer" },
              "on-site": { "type": "integer" },
              "checking-in": { "type": "integer" },
              "waiting-for-access": { "type": "integer" },
              "waiting-for-equipment": { "type": "integer" },
              "in-progress": { "type": "integer" },
              "on-hold": { "type": "integer" },
              "completed": { "type": "integer" },
              "failed": { "type": "integer" },
              "cancelled": { "type": "integer" },
              "deferred": { "type": "integer" },
              "facility-not-accessible": { "type": "integer" },
              "parts-required": { "type": "integer" },
              "requires-rescheduling": { "type": "integer" }
            }
          },
          "byPriority": {
            "type": "object",
            "properties": {
              "critical": { "type": "integer" },
              "high": { "type": "integer" },
              "medium": { "type": "integer" },
              "low": { "type": "integer" }
            }
          },
          "engineerUtilisation": {
            "type": "object",
            "properties": {
              "total": { "type": "integer" },
              "available": { "type": "integer" },
              "busy": { "type": "integer" },
              "onLeave": { "type": "integer" }
            }
          },
          "slaBreaches": { "type": "integer" },
          "avgCompletionTime": { "type": "number", "nullable": true, "description": "Average completion time in minutes" }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": { "type": "string" },
          "message": { "type": "string" }
        }
      }
    }
  }
}
